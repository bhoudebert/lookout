          "title",
          "summary",
          "excerpt",
          "published_at",
          "sources",
          "channel",
          "author",
          "feed_tags",
          "tags",
          "priority",
          "priority_label",
          "priority_reason",
          "action_needed",
          "state",
          "snoozed_until",
          "starred",
          "stack_matches",
