          },
          "priority_reason": {
            "title": "Priority Reason",
            "type": "string"
          }
        },
        "required": [
          "priority",
          "priority_reason",
          "model_score",
          "boost",
          "contributions"
        ],
        "title": "ExplanationOut",
        "type": "object"
      },
      "FieldOut": {
        "description": "One setting a type of source takes.",
        "properties": {
          "default": {
            "title": "Default"
          },
          "help": {
            "title": "Help",
            "type": "string"
          },
          "kind": {
            "description": "text, list (one entry per line), bool or number",
