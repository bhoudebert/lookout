{
  "components": {
    "schemas": {
      "Action": {
        "description": "What the user can do to an item.",
        "enum": [
          "open",
          "done",
          "dismiss",
          "snooze",
          "reopen",
          "star",
          "unstar"
        ],
        "title": "Action",
        "type": "string"
      },
      "ActionIn": {
        "description": "Do something to an item.",
        "properties": {
          "action": {
            "$ref": "#/components/schemas/Action"
          },
          "hours": {
            "default": 24.0,
            "description": "Snooze duration, used by `snooze` without `until`.",
            "exclusiveMinimum": 0.0,
            "title": "Hours",
            "type": "number"
          },
          "until": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Until"
          }
        },
        "required": [
          "action"
        ],
        "title": "ActionIn",
        "type": "object"
      },
      "ActionOut": {
        "description": "The item after an action, and how to undo it.",
        "properties": {
          "item": {
            "$ref": "#/components/schemas/ItemOut"
          },
          "undo": {
            "$ref": "#/components/schemas/UndoOut"
          }
        },
        "required": [
          "item",
          "undo"
        ],
        "title": "ActionOut",
        "type": "object"
      },
      "BulkIn": {
        "description": "The same action on several items.",
        "properties": {
          "action": {
            "$ref": "#/components/schemas/Action"
          },
          "hours": {
            "default": 24.0,
            "description": "Snooze duration, used by `snooze` without `until`.",
            "exclusiveMinimum": 0.0,
            "title": "Hours",
            "type": "number"
          },
          "ids": {
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "title": "Ids",
            "type": "array"
          },
          "until": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Until"
          }
        },
        "required": [
          "action",
          "ids"
        ],
        "title": "BulkIn",
        "type": "object"
      },
      "BulkOut": {
        "description": "How many items changed.",
        "properties": {
          "changed": {
            "title": "Changed",
            "type": "integer"
          }
        },
        "required": [
          "changed"
        ],
        "title": "BulkOut",
        "type": "object"
      },
      "ChannelIn": {
        "description": "A new channel.",
