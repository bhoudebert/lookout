              "type": "string"
            },
            "title": "Sources",
            "type": "array"
          }
        },
        "required": [
          "name",
          "description"
        ],
        "title": "ChannelOut",
        "type": "object"
      },
      "ChannelPatch": {
        "description": "A new description for a channel.",
